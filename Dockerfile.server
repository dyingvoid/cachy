# syntax=docker/dockerfile:1

FROM golang:1.27.1-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build \
    -buildvcs=false \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/cachy-server \
    ./cmd/server

FROM alpine:3.22

# netcat is used by the compose healthchecks.
RUN apk add --no-cache ca-certificates netcat-openbsd \
    && addgroup -S cachy \
    && adduser -S -G cachy -h /home/cachy cachy

COPY --from=build /out/cachy-server /usr/local/bin/cachy-server

USER cachy

EXPOSE 8081 8082

ENTRYPOINT ["/usr/local/bin/cachy-server"]
