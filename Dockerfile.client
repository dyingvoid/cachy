# syntax=docker/dockerfile:1

FROM golang:1.27.1-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build \
    -buildvcs=false \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/cachy-client \
    ./cmd/client

FROM alpine:3.22

RUN addgroup -S cachy \
    && adduser -S -G cachy -h /home/cachy cachy

COPY --from=build /out/cachy-client /usr/local/bin/cachy-client

USER cachy

ENTRYPOINT ["/usr/local/bin/cachy-client"]
